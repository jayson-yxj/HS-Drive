{
  "stage": "M6-F",
  "source": "Privileged",
  "schema": "m6f.real_engine_telemetry.v1",
  "backend": "CARLA 0.9.16 / UE4.26 / PhysX, independently installed",
  "true_engine_wheel_api": true,
  "coordinate_frame": "CARLA world x forward, y right, z up for raw body; speed is signed body forward. Wheel force/slip are local tire longitudinal/lateral scalars, NOT world vectors. Wheel order follows PVehicle index; corner mapping not independently certified.",
  "time": {
    "body": "ActorSnapshot frame and elapsed_seconds",
    "telemetry": "No internal frame or timestamp field",
    "association": "sole tick owner; snapshot brackets around synchronous RPC must have identical frame; expected next frame checked after tick",
    "substep": "NotAvailable",
    "force_time": "debug fields read at RPC, substep aggregation/refresh phase not certified",
    "forbidden": "Do not claim same-frame force equals interval-averaged force or reconstruct exact solver impulse from it",
    "state_mutation_barrier": "PhysicsControl/teleport mutation invalidates same-state snapshot association even without tick. Init records kept separate; no derivatives across rebuild."
  },
  "vehicle_fields": {
    "speed": {
      "units": "m/s",
      "source": "GetVehicleForwardSpeed()/100",
      "kind": "engine state"
    },
    "steer/throttle/brake": {
      "units": "normalized command",
      "source": "LastAppliedControl",
      "kind": "CARLA applied command, not smoothed PhysX input"
    },
    "gear": {
      "units": "integer index",
      "source": "GetVehicleCurrentGear",
      "kind": "engine state"
    },
    "engine_rpm": {
      "units": "rpm",
      "source": "MovementComponent.GetEngineRotationSpeed",
      "kind": "engine state, engine model of Tesla blueprint, not electric motor validation"
    },
    "drag": {
      "units": "N",
      "source": "DebugDragMagnitude/100",
      "kind": "engine debug value"
    }
  },
  "wheel_fields": {
    "tire_friction": {
      "units": "dimensionless",
      "source": "PxWheelQueryResult.tireFriction",
      "kind": "contact friction coefficient, not Physics tire_friction scale"
    },
    "lat_slip": {
      "units": "degrees",
      "source": "RadiansToDegrees(PxWheelQueryResult.lateralSlip)"
    },
    "long_slip": {
      "units": "dimensionless",
      "source": "PxWheelQueryResult.longitudinalSlip"
    },
    "omega": {
      "units": "rad/s",
      "source": "PxVehicleWheelsDynData.getWheelRotationSpeed"
    },
    "tire_load": {
      "units": "N",
      "source": "UVehicleWheel.DebugTireLoad/100"
    },
    "normalized_tire_load": {
      "units": "dimensionless",
      "source": "UVehicleWheel.DebugNormalizedTireLoad"
    },
    "torque": {
      "units": "N m",
      "source": "UVehicleWheel.DebugWheelTorque/10000",
      "semantic": "engine debug wheel torque; decomposition into tire/brake/drive unavailable; NOT actual brake torque"
    },
    "long_force/lat_force": {
      "units": "N",
      "source": "UVehicleWheel.DebugLongForce/DebugLatForce divided by100",
      "semantic": "tire-axis debug force; not body net force or time-integrated impulse"
    },
    "normalized_long_force/normalized_lat_force": {
      "units": "dimensionless",
      "source": "abs(force)*normalized_load/load",
      "semantic": "CARLA computed ratio, may be nonfinite at zero tire load; raw nonfinite represented explicitly, never zero imputation"
    }
  },
  "not_available": [
    "actual per-wheel applied brake torque",
    "drive and brake torque decomposition",
    "clutch engagement state/torque",
    "smoothed PhysX analog input",
    "gear switch progress",
    "wheel contact normal/point/material identity",
    "suspension force history",
    "solver substep timestamps",
    "constraint/contact impulses",
    "exact package-to-engine-source build manifest"
  ],
  "derived_body_fields": {
    "acceleration": "raw finite difference of signed snapshot speed, interval ending frame; API acceleration retained separately",
    "jerk": "difference of raw finite-difference acceleration; 50ms sample scale, not instantaneous solver jerk",
    "not_engine_measurement": true
  },
  "invalid_handling": "nonfinite engine fields preserved as invalid_raw text; absent fields raise; frame mismatch aborts batch",
  "formal_control_use": false,
  "sources": [
    "https://github.com/carla-simulator/carla/blob/0.9.16/Unreal/CarlaUE4/Plugins/Carla/Source/Carla/Vehicle/CarlaWheeledVehicle.cpp",
    "https://github.com/carla-simulator/carla/blob/0.9.16/Unreal/CarlaUE4/Plugins/Carla/Source/Carla/Vehicle/VehicleTelemetryData.h",
    "https://github.com/carla-simulator/carla/blob/0.9.16/LibCarla/source/carla/rpc/VehicleTelemetryData.h"
  ],
